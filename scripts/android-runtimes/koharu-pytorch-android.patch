diff --git a/caffe2/CMakeLists.txt b/caffe2/CMakeLists.txt
index e4a0454..98ae521 100644
--- a/caffe2/CMakeLists.txt
+++ b/caffe2/CMakeLists.txt
@@ -2085,3 +2085,13 @@ if(MSVC)
   endforeach()
 endif()
 endif()
+
+# Koharu: the JIT IR header instantiates c10::DynamicType::fallback() from a
+# template inside the tch shim, so the definition has to be in libtorch_cpu's
+# dynamic symbol table. The global -fvisibility=hidden keeps it out.
+if(KOHARU_FULL_LIBTORCH)
+  set_source_files_properties(
+    ${PROJECT_SOURCE_DIR}/aten/src/ATen/core/dynamic_type.cpp
+    PROPERTIES COMPILE_OPTIONS "-fvisibility=default" # KOHARU_FULL_LIBTORCH visibility
+  )
+endif()
diff --git a/cmake/Dependencies.cmake b/cmake/Dependencies.cmake
index 2baa187..9fe2639 100644
--- a/cmake/Dependencies.cmake
+++ b/cmake/Dependencies.cmake
@@ -430,7 +430,10 @@ set(CONFU_DEPENDENCIES_BINARY_DIR ${PROJECT_BINARY_DIR}/confu-deps
 # ---[ pthreadpool
 # Only add a dependency on pthreadpool if we are on a mobile build
 # or are building any of the libraries in the {Q/X}NNPACK family.
-if(INTERN_BUILD_MOBILE OR NOT DISABLE_NNPACK_AND_FAMILY)
+# Koharu: Android is a C10_MOBILE platform regardless of INTERN_BUILD_MOBILE
+# (see torch/headeronly/macros/Macros.h), so ATen's native parallel backend
+# always needs caffe2::pthreadpool.  Enable it here too.
+if(INTERN_BUILD_MOBILE OR ANDROID OR NOT DISABLE_NNPACK_AND_FAMILY)
   set(USE_PTHREADPOOL ON CACHE BOOL "" FORCE)
   set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DUSE_PTHREADPOOL")
 
@@ -1399,7 +1402,10 @@ if(CAFFE2_CMAKE_BUILDING_WITH_MAIN_REPO AND NOT INTERN_DISABLE_ONNX)
   if(NOT USE_SYSTEM_ONNX)
     # In mobile build we care about code size, and so we need drop
     # everything (e.g. checker) in onnx but the pb definition.
-    if(ANDROID OR IOS)
+    # Koharu: an Android build that keeps the full C++ frontend
+    # (KOHARU_FULL_LIBTORCH) also compiles the JIT ONNX serialization sources,
+    # which call ONNX's checker and shape inference, not just the proto defs.
+    if((ANDROID OR IOS) AND NOT KOHARU_FULL_LIBTORCH)
       caffe2_interface_library(onnx_proto onnx_library)
     else()
       caffe2_interface_library(onnx onnx_library)

diff --git a/aten/src/ATen/native/mkldnn/IDeepRegistration.cpp b/aten/src/ATen/native/mkldnn/IDeepRegistration.cpp
index 4935286..9e7e380 100644
--- a/aten/src/ATen/native/mkldnn/IDeepRegistration.cpp
+++ b/aten/src/ATen/native/mkldnn/IDeepRegistration.cpp
@@ -4,6 +4,7 @@
 #if AT_MKLDNN_ENABLED()
 
 #include <c10/core/Allocator.h>
+#include <c10/core/impl/alloc_cpu.h>
 // needs to be included only once in library.
 #include <ideep_pin_singletons.hpp>
 #include <ATen/native/mkldnn/IDeepRegistration.h>
@@ -12,12 +13,25 @@ using namespace ideep;
 
 static RegisterEngineAllocator cpu_alloc(
   engine::cpu_engine(),
+#ifdef C10_MOBILE
+  // Koharu: on C10_MOBILE the default CPU allocator is
+  // DefaultMobileCPUAllocator, whose raw_allocate() returns the pre-guard
+  // offset pointer while raw_deallocate() expects the base context pointer.
+  // ideep wants a plain malloc/free pair, so use c10's CPU entry points.
+  [](size_t size) {
+    return c10::alloc_cpu(size);
+  },
+  [](void* p) {
+    c10::free_cpu(p);
+  }
+#else
   [](size_t size) {
     return c10::GetAllocator(c10::DeviceType::CPU)->raw_allocate(size);
   },
   [](void* p) {
     c10::GetAllocator(c10::DeviceType::CPU)->raw_deallocate(p);
   }
+#endif
 );
 
 namespace at::native::mkldnn{
